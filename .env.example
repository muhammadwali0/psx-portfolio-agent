# ── Application ───────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TEMPERATURE=0.2

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ── Portfolio Defaults ────────────────────────────────────────────────────────
PORTFOLIO_CAPITAL_PKR=1000000
PORTFOLIO_MAX_POSITIONS=10
PORTFOLIO_MAX_SINGLE_STOCK_PCT=0.20
RISK_FREE_RATE=0.21

# ── Scraping ──────────────────────────────────────────────────────────────────
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_MAX_RETRIES=3
PSX_DOWNLOAD_BASE_URL=https://dps.psx.com.pk/download
HISTORICAL_DB_PATH=data/psx_history.db
HISTORICAL_BACKFILL_DAYS=90

# ── Redis (optional — enables persistent cross-instance run store) ─────────────
# REDIS_URL=redis://localhost:6379/0

# ── Google Cloud (for Cloud Run deployment) ───────────────────────────────────
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_REGION=us-central1
